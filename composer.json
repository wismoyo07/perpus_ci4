{
    "name": "wismoyo07/perpus_ci4",
    "description": "Sistem informasi perpustakaan sekolah berbasis CodeIgniter 4: katalog & DDC, sirkulasi, denda per buku, kwitansi, kartu anggota, dan label buku.",
    "license": "MIT",
    "type": "project",
    "keywords": ["perpustakaan", "library", "sekolah", "codeigniter4"],
    "homepage": "https://github.com/wismoyo07/perpus_ci4",
    "support": {
        "issues": "https://github.com/wismoyo07/perpus_ci4/issues",
        "source": "https://github.com/wismoyo07/perpus_ci4"
    },
    "require": {
        "php": "^8.2",
        "chillerlan/php-qrcode": "^6.0",
        "codeigniter4/framework": "^4.7",
        "picqer/php-barcode-generator": "^3.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9",
        "mikey179/vfsstream": "^1.6",
        "phpunit/phpunit": "^10.5.16"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Support\\": "tests/_support"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
